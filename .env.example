# Salin berkas ini menjadi .env lalu isi nilainya.
# .env tidak ikut ter-commit (.gitignore) dan isinya tidak pernah ditampilkan
# di dashboard — hanya panjang kuncinya, untuk memastikan tidak terpotong.

# --- Wajib -------------------------------------------------------------------
# Tanpa kunci ini, seluruh mesin tetap berjalan deterministik; hanya lapisan
# penasihat AI yang mati.
OPENAI_API_KEY=

# Model yang dipanggil. Harus model yang memang tersedia di endpoint di bawah.
OPENAI_MODEL=gpt-4o-mini


# --- Opsional: memakai gateway/proksi lain -----------------------------------
# Bila memakai gateway (SumoPod, OpenRouter, vLLM, dsb.), HAPUS tanda "#" di
# awal baris berikut, isi alamatnya, dan samakan OPENAI_MODEL dengan model yang
# disediakan gateway itu.
#
# Perhatikan akhiran "/v1": klien memanggil <OPENAI_BASE_URL>/chat/completions,
# jadi tulis alamat lengkap sampai /v1 bila gateway memakainya.
#
#OPENAI_BASE_URL=


# --- Opsional lain -----------------------------------------------------------
# Biner idx bila tidak diletakkan di vendor/idx/bin/.
#IDX_BIN=C:\path\ke\idx.exe
